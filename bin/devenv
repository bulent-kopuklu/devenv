#!/usr/bin/env python3
"""devenv - a two-role project: the product repo, the reviewer, and the devshell.

    devenv create ornek go rust --speckit
    devenv create . rust cpp --target aarch64
    devenv create ornek node --node 22

<name>/<name>-impl is the product repo. The templates are copied there and the
devshell is built so the runtimes are on disk. It creates no source files and
reads no project tree: languages are what you name. Nothing is committed -
created files land in .git/info/exclude, except flake.nix, which is
intent-to-added because nix reads only files git knows about, and the root
Makefile, which drives components/ and belongs to the project.

<name>/<name>-ctrl is the reviewer's directory and <name>/CLAUDE.md carries the
shared protocol. Role texts are not copied: the project files import them from
the Claude config directory, so one install updates them all. `devenv create .`
takes the current directory as <name>/ and its name as the project name.
"""
import argparse, json, os, shutil, subprocess, sys, tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
#: Sablonlar iki yerde olabilir: depoda `<kok>/templates`, kurulumda ise
#: `~/.local/share/dev-templates/templates`. install.sh bu script'i KOPYALIYOR,
#: yani kurulu halde `__file__` artik depoda degil ve depo-goreli yol bos cikar.
#: Depo once denenir; boylece klondan calistirmak da calisir.
SHARE = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "dev-templates"
TEMPLATES = next((c for c in (ROOT / "templates", SHARE / "templates") if c.is_dir()),
                 ROOT / "templates")
REF = os.environ.get("DEV_TEMPLATES_REF", "github:bulent-kopuklu/devenv")
LANGS = ["rust", "cpp", "go", "node", "java", "android"]
ALIAS = {"c++": "cpp", "cxx": "cpp", "c": "cpp", "ts": "node", "js": "node",
         "typescript": "node", "golang": "go", "arm64": "aarch64", "arm": "armv7", "armv7l": "armv7"}

#: Companion'in release zip'i build toolchain'ini (build-pipeline.py, nodes/,
#: fragments/) gondermiyor ve onlarsiz pipeline ozellestirilemez; bu yuzden
#: extension'lar klondan, `--dev` ile kurulur.
#: Dile ozgu AI kurallari. Secilen her dil icin `templates/rules/<dil>.md`
#: aranir; varsa `.claude/rules/` altina KOPYALANIR ve CLAUDE.md oradan import
#: eder. Proje disina link verilmez: agac kendi kendine yeter.
AI_RULES = TEMPLATES / "rules"
COMPANION = os.environ.get("SPECKIT_COMPANION", "https://github.com/alfredoperez/speckit-companion")
#: Rol metinlerini install.sh buraya kurar (`roles/`); proje dosyalari onlari
#: buradan import eder. Wiki, denetcinin ve spike'in yazdigi yer.
CONFIG = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude"))
WIKI = Path(os.environ.get("CC_WORKSPACE", Path.home() / "workspace/cc-workspace"))

VERSION = "2.0.0"
#: install.sh kopyalarken bunu deponun commit'iyle degistirir; depodan
#: calistirilinca yerinde kalir ve git'ten okunur.
BUILD = "@BUILD@"

created = []


def build_info():
    if BUILD != "@" + "BUILD@":
        return BUILD
    git = lambda *a: subprocess.run(["git", "-C", str(ROOT), *a],
                                     capture_output=True, text=True).stdout.strip()
    commit = git("log", "-1", "--format=%h %cs")
    if not commit:
        return "kaynak bilinmiyor"
    return commit + (" +degisiklik" if git("status", "--porcelain") else "")


def copy(template):
    kaynak = TEMPLATES / template
    if not kaynak.is_dir():
        sys.exit(f"sablon bulunamadi: {kaynak}\n"
                 f"install.sh'i calistir; sablonlar {SHARE / 'templates'} altina kopyalanir.")
    for f in sorted(p for p in kaynak.rglob("*") if p.is_file()):
        rel = f.relative_to(TEMPLATES / template)
        if rel.exists():
            print(f"kept:    {rel}")
        else:
            rel.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(f, rel)
            created.append(str(rel))
            print(f"created: {rel}")


def edit(path, subs):
    p = Path(path)
    p.write_text(subs(p.read_text()))


def tilde(p):
    try:
        return "~/" + str(Path(p).relative_to(Path.home()))
    except ValueError:
        return str(p)


def render(template, dest, subs):
    """`templates/project/<template>` altindakileri dest'e yazar, `{{AD}}` yer
    tutucularini doldurarak. Var olan dosyaya dokunmaz; izin JSON'u haric: onun
    listelerine eksik girdiler eklenir, cunku mevcut bir repoyu iceri alirken
    oradaki izinler de korunmali."""
    src = TEMPLATES / "project" / template
    for f in sorted(p for p in src.rglob("*") if p.is_file()):
        dst = Path(dest) / f.relative_to(src)
        text = f.read_text()
        for k, v in subs.items():
            text = text.replace("{{" + k + "}}", v)
        if dst.exists() and dst.suffix == ".json":
            merge_permissions(dst, json.loads(text))
        elif dst.exists():
            print(f"kept:    {dst}")
        else:
            dst.parent.mkdir(parents=True, exist_ok=True)
            dst.write_text(text)
            print(f"created: {dst}")


def merge_permissions(path, new):
    cfg = json.loads(path.read_text())
    perms = cfg.setdefault("permissions", {})
    added = 0
    for key, values in new.get("permissions", {}).items():
        have = perms.setdefault(key, [])
        for v in values:
            if v not in have:
                have.append(v)
                added += 1
    if added:
        path.write_text(json.dumps(cfg, indent=2) + "\n")
        print(f"edited:  {path} ({added} izin eklendi)")
    else:
        print(f"kept:    {path}")


def nix_list(name, values):
    return f'  {name} = [ ' + "".join(f'"{v}" ' for v in values) + '];'


def run(*cmd):
    if subprocess.run(cmd).returncode != 0:
        sys.exit(f"basarisiz: {' '.join(cmd)}")


def add_extension(source):
    """Extension'i yerel bir dizinden kurar; kaynak URL ise once klonlar.

    Extension'in kokunu `extension.yml` belirler, deponun koku degil: bazi
    depolar onu bir alt dizinde tutuyor (companion `speckit-extension/`'da).
    """
    src, tmp = Path(source).expanduser(), None
    if not src.is_dir():
        tmp = Path(tempfile.mkdtemp(prefix="speckit-ext-"))
        run("git", "clone", "--depth", "1", "-q", source, str(tmp))
        src = tmp
    if not (src / "extension.yml").is_file():
        # Depoda birden fazla `extension.yml` olabilir: kurulu bir kopya
        # (`.specify/extensions/*`), ornekler, test verileri. Bunlar elenir ve
        # kalanlardan koke en yakini alinir; iki aday ayni derinlikteyse
        # secilmez, cunku yanlis extension sessizce kurulur.
        noise = {".git", ".specify", "examples", "test", "tests", "fixtures", "node_modules"}
        hits = [h for h in src.rglob("extension.yml") if not noise & set(h.parts)]
        hits.sort(key=lambda h: len(h.parts))
        if not hits:
            sys.exit(f"extension.yml bulunamadi: {source}")
        if len(hits) > 1 and len(hits[0].parts) == len(hits[1].parts):
            sys.exit("birden fazla extension koku: "
                     + ", ".join(str(h.parent.relative_to(src)) for h in hits))
        src = hits[0].parent
    run("specify", "extension", "add", str(src), "--dev", "--force")
    print(f"extension: {src.name} <- {source}")
    if tmp:
        shutil.rmtree(tmp, ignore_errors=True)


def speckit():
    """Spec Kit'i bu projeye kurar: CLI guncel, init, extension'lar, anayasa.

    Sira onemli. `init` .specify/ agacini yaratir; extension'lar ona yazar;
    anayasa en sona kalir cunku init kendi sablonunu birakiyor ve bizimki onun
    yerine gecmeli.

    Orchestration extension'i kurulmaz: hakem subagent'i ve after_* hook'lari
    karari yazan oturumun icinde verir, o karar denetcinindir.
    """
    if not shutil.which("specify"):
        sys.exit("specify yok: uv tool install specify-cli --from git+https://github.com/github/spec-kit.git")
    run("specify", "self", "upgrade")
    run("specify", "init", "--here", "--force", "--non-interactive",
        "--script", "sh", "--integration", "claude", "--extension", "git", "--extension", "agent-context")
    add_extension(COMPANION)

    src = TEMPLATES / "speckit" / "constitution.md"
    dst = Path(".specify/memory/constitution.md")
    if not src.is_file():
        print(f"atlandi: anayasa ({src} yok)")
    else:
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dst)
        print(f"created: {dst} (cekirdek anayasa; urune ozel ilkeleri sen eklersin)")

    # Companion kendi workflow'unu extension agacina birakiyor ama KURMUYOR;
    # kurulmadan `specify workflow run speckit-companion` calismaz ve stock
    # workflow companion komutlarini degil `speckit.*` komutlarini cagirir.
    wf = Path(".specify/extensions/companion/workflows/speckit-companion.workflow.yml")
    if wf.is_file():
        run("specify", "workflow", "add", str(wf))
    else:
        print(f"atlandi: companion workflow ({wf} yok)")

    node_replacement()
    optional_hooks()

    # Living specs Companion'da opt-in. Bos ve acik bir registry specify/plan'a
    # bir sey yuklemez; implement sahipsiz dosyalar icin capability'yi kendisi
    # kaydeder, boylece capability niyetten dogar, sonradan koddan turetilmez.
    ls = Path("living-specs.yml")
    if ls.exists():
        print(f"kept:    {ls}")
    else:
        ls.write_text("enabled: true\ncapabilities: []\n")
        subprocess.run(["git", "add", "-N", str(ls)], check=True)
        print(f"created: {ls} (living specs acik, bos; git add it to keep it)")




def optional_hooks():
    """Optional hook'lari insansiz kosuya gore ayarlar.

    Companion optional bir hook'u calistirmaz, "calistirayim mi?" diye basar;
    insansiz kosuda bu bir bekleme noktasidir. Iki extension'in optional
    hook'lari var ve ikisi ayri cozulur:

    - git: hepsi `speckit.git.commit`. Kapatilir (`enabled: false`) — commit'i
      kosuyu yapan atar; git-config.yml'de auto_commit acilsa da sabit
      "[Spec Kit] ..." mesajiyla commit atar, Conventional Commits'e uymaz.
      Spec basina branch acan hook zaten zorunlu, dokunulmaz.
    - agent-context: CLAUDE.md'deki SPECKIT START/END blogunu gunceller.
      Zorunlu yapilir (`optional: false`) — kapatilirsa blogu kimse doldurmaz.
    """
    kural = {"git": ("    enabled: true\n", "    enabled: false\n"),
             "agent-context": ("    optional: true\n", "    optional: false\n")}
    p = Path(".specify/extensions.yml")
    if not p.is_file():
        print(f"atlandi: hook ayari ({p} yok)")
        return
    satirlar = p.read_text().splitlines(keepends=True)
    cikti, sayac, i = [], {e: 0 for e in kural}, 0
    while i < len(satirlar):
        ext = satirlar[i].rstrip().removeprefix("  - extension: ")
        if ext == satirlar[i].rstrip() or ext not in kural:
            cikti.append(satirlar[i])
            i += 1
            continue
        j = next((k for k in range(i + 1, len(satirlar)) if not satirlar[k].startswith("    ")), len(satirlar))
        girdi = satirlar[i:j]
        if "    optional: true\n" in girdi:
            eski, yeni = kural[ext]
            girdi = [yeni if s == eski else s for s in girdi]
            sayac[ext] += 1
        cikti += girdi
        i = j
    if not any(sayac.values()):
        print(f"UYARI:   {p} icinde ayarlanacak optional hook bulunamadi; bicim degismis olabilir")
        return
    p.write_text("".join(cikti))
    print(f"edited:  {p} ({sayac['git']} git commit hook'u kapatildi, "
          f"{sayac['agent-context']} agent-context hook'u zorunlu yapildi)")

def node_replacement():
    """Companion'in plan-doc node'unun yerine bizimkini koyar: plan'in yerlesim
    kurali sablondan.

    Extension `provides:` yalnizca commands/templates/scripts aliyor, yani bir
    extension proje overlay'ine (`.specify/companion/nodes/`) yazamaz. Kopyayi
    burasi atar. Replacement hala bir node'dur: id'sini, phase'ini ve `reads:`
    alanini korur, ona takili hook'lar fire etmeye devam eder. Geri almak icin
    dosyayi silmek yeter.
    """
    kok = TEMPLATES / "speckit" / "nodes"
    dosyalar = sorted(kok.rglob("*.md")) if kok.is_dir() else []
    if not dosyalar:
        print("atlandi: node replacement (kaynak yok)")
        return
    for src in dosyalar:
        dst = Path(".specify/companion/nodes") / src.relative_to(kok)
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dst)
        print(f"created: {dst}")
    build = Path(".specify/extensions/companion/scripts/build-pipeline.py")
    if build.is_file():
        run("python3", str(build))
    else:
        print(f"atlandi: pipeline build ({build} yok) — replacement govdeye islenmedi")




ORNEKLER = """ornekler:
  devenv create ornek go rust --speckit   ./ornek/ornek-impl ve ./ornek/ornek-ctrl
  devenv create . go rust                 bulundugun dizin proje dizini, adi proje adi
  devenv create ornek cpp --target aarch64
  devenv create ornek node --node 22"""

CREATE = """Iki rollu bir proje kurar:

  <ad>/            git degil; Claude burada calismaz. CLAUDE.md ortak protokolu import eder
    <ad>-impl/     urun reposu: flake.nix, Makefile, CLAUDE.md; --speckit ile Spec Kit.
                   devshell burada derlenir. Rol import'u ve izinler git disinda:
                   CLAUDE.local.md, .claude/settings.local.json
    <ad>-ctrl/     denetci: CLAUDE.md, .claude/settings.json, record.md

Rol metinleri kopyalanmaz, Claude config dizininden import edilir; once
dev-templates'te install.sh calismis olmali. Var olan dosyalara dokunulmaz,
izin listeleri birlestirilir.

Mevcut bir repoyu almak icin: repoyu <ad>/<ad>-impl'e tasi, <ad>/ icinde
`devenv create . <diller>` calistir (--speckit'siz; kurulu Spec Kit ezilmez)."""


def parser():
    ap = argparse.ArgumentParser(
        prog="devenv", formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Iki rollu proje: <ad>/<ad>-impl (urun, yazan) ve <ad>/<ad>-ctrl (denetci).",
        epilog=ORNEKLER)
    ap.add_argument("--version", action="version", version=f"devenv {VERSION} ({build_info()})")
    sub = ap.add_subparsers(dest="command", required=True, metavar="komut")
    c = sub.add_parser("create", help="yeni proje kur ya da tasinmis bir repoyu duzene al",
                       formatter_class=argparse.RawDescriptionHelpFormatter,
                       description=CREATE, epilog=ORNEKLER)
    c.add_argument("name", metavar="ad",
                   help="proje adi, ya da `.`: bulundugun dizin proje dizinidir ve adi proje adidir. "
                        "Urunun icindeki adlar bundan gelir, dizin adindan degil")
    c.add_argument("langs", metavar="dil", nargs="+", help=" | ".join(LANGS))
    c.add_argument("--target", action="append", default=[],
                   help="capraz derleme hedefi: aarch64 | armv7 (tekrarlanabilir)")
    c.add_argument("--node", help=".nvmrc icin node major surumu, ornek 22")
    c.add_argument("--speckit", action="store_true",
                   help="Spec Kit kur: self upgrade, init + git (spec basina branch) + agent-context "
                        "(CLAUDE.md blogu), companion, living specs acik, generic anayasa")
    return ap


def create_project(name):
    """Iki rollu duzeni kurar ve impl'e gecer; impl'in kurulumu main'e kalir.

    Ust dizin git reposu olamaz: Claude'un hafizasi repoya gore tutulur, ust
    dizin repo olursa impl ile ctrl ayni hafizayi paylasir.
    """
    if name == ".":
        root = Path.cwd()
        name = root.name
    elif not name or "/" in name or name == "..":
        sys.exit(f"gecersiz proje adi: {name!r}")
    else:
        root = Path.cwd() / name
    if (root / ".git").exists():
        sys.exit(f"{root} bir git reposu; ust dizin repo olamaz. "
                 f"Repoyu {root}/{name}-impl altina tasi, sonra yeniden calistir (--speckit'siz).")
    impl, ctrl = root / f"{name}-impl", root / f"{name}-ctrl"
    impl.mkdir(parents=True, exist_ok=True)
    ctrl.mkdir(exist_ok=True)
    subs = {"NAME": name, "ROOT": str(root), "CONFIG": tilde(CONFIG), "WIKI": str(WIKI)}
    render("parent", root, subs)
    render("ctrl", ctrl, subs)
    if not (CONFIG / "roles" / "protocol.md").is_file():
        print(f"UYARI:   {CONFIG / 'roles'} yok; proje dosyalarinin import'lari bos kalir. "
              "dev-templates'te install.sh'i calistir.")
    os.chdir(impl)
    return subs


def main():
    a = parser().parse_args()

    langs = [ALIAS.get(l.lower(), l.lower()) for l in a.langs]
    unknown = [l for l in langs if l not in LANGS]
    if unknown:
        sys.exit(f"unknown language: {' '.join(unknown)} (pick from {' '.join(LANGS)})")
    targets = [ALIAS.get(t.lower(), t.lower()) for t in a.target if t.lower() != "none"]

    subs = create_project(a.name)
    setup(a, langs, targets, subs)
    build()
    root, name = subs["ROOT"], subs["NAME"]
    print(f"oturumlar: cd {root}/{name}-impl && claude -n {name}-impl")
    print(f"           cd {root}/{name}-ctrl && claude -n {name}-ctrl")


def setup(a, langs, targets, subs):
    if not Path(".git").is_dir():
        subprocess.run(["git", "init", "-q"], check=True)
        print("created: .git")

    if Path("flake.nix").exists() or Path("shell.nix").exists():
        print("kept:    flake.nix/shell.nix (theirs)")
    else:
        copy("base")
        edit("flake.nix", lambda t: t
             .replace('dev-templates.url = "github:bulent-kopuklu/devenv";',
                      f'dev-templates.url = "{REF}";')
             .replace('  langs = [ ];', nix_list("langs", langs))
             .replace('  targets = [ ];', nix_list("targets", targets) if targets else '  targets = [ ];'))
        subprocess.run(["git", "add", "-N", "flake.nix"], check=True)
        print("git:     flake.nix intent-to-added so nix can read it; git add it to keep it")

    if not Path("Makefile").exists():
        copy("make")
        subprocess.run(["git", "add", "-N", "Makefile"], check=True)
        print("git:     Makefile intent-to-added; it belongs to the project, git add it to keep it")

    if not Path(".envrc").exists():
        Path(".envrc").write_text("use flake\n")
        created.append(".envrc")
        print("created: .envrc")

    if a.node and not any(Path(f).exists() for f in (".nvmrc", ".node-version")):
        Path(".nvmrc").write_text(f"{a.node}\n")
        subprocess.run(["git", "add", "-N", ".nvmrc"], check=True)
        print(f"git:     .nvmrc ({a.node}) intent-to-added; the flake reads only what git knows")

    for l in langs:
        if l == "cpp":
            copy("cpp")
        elif l == "rust" and not Path(".rustfmt.toml").exists():
            copy("rust")
        elif l == "go":
            copy("go")
        elif l == "node" and not any(Path(".").glob(g) for g in ("biome.json*", ".prettierrc*", "prettier.config.*")):
            copy("node")
    copy("claude")
    if Path("CLAUDE.md").exists():
        edit("CLAUDE.md", lambda t: t.replace("# PROJECT_NAME", f"# {subs['NAME']}"))
        body = Path("CLAUDE.md").read_text()
        imports = []
        for l in langs:
            src = AI_RULES / f"{l}.md"
            if not src.is_file():
                continue
            dst = Path(".claude/rules") / f"{l}.md"
            if dst.exists():
                print(f"kept:    {dst}")
            else:
                dst.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(src, dst)
                created.append(str(dst))
                print(f"created: {dst}")
            if f"@{dst}" not in body:
                imports.append(f"- @{dst}\n")
        if imports:
            # Capa: sablonun Kurallar bolumundeki global-kurallar maddesi.
            # Import'lar onun ALTINA girer. Capa sablondan kalkarsa import'lar
            # sessizce yazilmaz; o yuzden ikisi birlikte degisir.
            capa = "- `~/.claude/CLAUDE.md` i"
            def ekle(metin):
                for satir in metin.splitlines(keepends=True):
                    if satir.startswith(capa):
                        return metin.replace(satir, satir + "".join(imports), 1)
                sys.exit(f"CLAUDE.md'de capa bulunamadi: {capa!r}")
            edit("CLAUDE.md", ekle)
            print(f"claude:  {len(imports)} kural dosyasi import edildi")

    # Rol import'u ve izinler makineye ozgu (mutlak yollar), commit'lenmez:
    # repoyu baska makinede acan kirik bir import gormesin.
    render("impl", Path("."), subs)
    created.extend(["CLAUDE.local.md", ".claude/settings.local.json", "handoff.md"])

    already = Path(".git/info/exclude").read_text().splitlines()
    excluded = [f for f in created + [".direnv/"] if f not in ("flake.nix", "Makefile") and f not in already]
    if excluded:
        with open(".git/info/exclude", "a") as f:
            f.write("# dev-templates (local only)\n" + "\n".join(excluded) + "\n")
        for e in excluded:
            print(f"excluded: {e}")

    if a.speckit and Path(".specify").is_dir():
        # Iceri alinan repoda init --force kurulu Spec Kit'i ezer.
        print("atlandi: speckit (.specify/ zaten var)")
    elif a.speckit:
        speckit()


def build():
    if shutil.which("direnv"):
        subprocess.run(["direnv", "allow", "."], check=True)
        print("direnv:  allowed")
    print("building the devshell (runtimes, LSPs, formatters) ...")
    if subprocess.run(["nix", "develop", "--command", "true"]).returncode != 0:
        sys.exit("devshell failed to build; the nix error is above")
    print("ready. open the editor from this shell: code .")


if __name__ == "__main__":
    main()
