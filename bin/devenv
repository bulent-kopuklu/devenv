#!/usr/bin/env python3
"""devenv - a project and its devshell; with --speckit, a two-role project.

    devenv create ornek go rust --speckit
    devenv create . rust cpp --target aarch64
    devenv create ornek node --node 22
    devenv add rust

Without --speckit <name>/ is the product repo. With --speckit the product repo
is <name>/<name>-impl. The templates are copied into the product repo and the
devshell is built so the runtimes are on disk. It creates no source files and
reads no project tree: languages are what you name. Nothing is committed.
Files that are machine-specific (the role import, absolute-path permissions,
.direnv/) land in .git/info/exclude; everything else belongs to the project.
flake.nix is intent-to-added because nix reads only files git knows about.

With --speckit <name>/<name>-ctrl is the reviewer's directory and
<name>/CLAUDE.md carries the shared protocol. Each role's text is copied into
its own .claude/rules/. `devenv create .` takes the current directory as
<name>/ and its name as the project name.

The root Makefile is a skeleton with the interface and no recipes; it hands
each goal to the components' own Makefiles, written when a component is added. `devenv add`, run in the product repo, adds
languages to an existing project: the flake's langs and the language's files
and rules. It overwrites nothing and leaves the Makefile alone.
"""
import argparse, importlib.util, os, re, shutil, subprocess, sys

sys.dont_write_bytecode = True  # dillerin create.py'si sablon dizininde __pycache__ birakmasin
from datetime import date
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
#: Sablonlar iki yerde olabilir: depoda `<kok>/templates`, kurulumda ise
#: `~/.local/share/devenv/templates`. install.sh bu script'i KOPYALIYOR,
#: yani kurulu halde `__file__` artik depoda degil ve depo-goreli yol bos cikar.
#: Depo once denenir; boylece klondan calistirmak da calisir.
SHARE = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "devenv"
TEMPLATES = next((c for c in (ROOT / "templates", SHARE / "templates") if c.is_dir()),
                 ROOT / "templates")
REF = os.environ.get("DEV_TEMPLATES_REF", "github:bulent-kopuklu/devenv")
LANGS = ["rust", "cpp", "go", "node", "java", "android"]
#: Bir dilin parcalari `templates/<dil>/` altinda: `files/` projeye kopyalanir,
#: `rules.md` `.claude/rules/<dil>.md`, `testing.md` `.claude/rules/<dil>-testing.md`
#: olur. Olmayan parca
#: atlanir. Dilde `create.py` varsa bunlar yapilmaz, o script cagrilir:
#: varsayilandan farkli olan dil ne yapacagina kendisi karar verir.
ALIAS = {"c++": "cpp", "cxx": "cpp", "c": "cpp", "ts": "node", "js": "node",
         "typescript": "node", "golang": "go", "arm64": "aarch64", "arm": "armv7", "armv7l": "armv7"}

#: Companion release zip'ten kurulur: yalniz komutlar ve script'ler. Klondan
#: `--dev` kurulum extension'in butun agacini urun reposuna koyar ve skill'leri
#: onun icindeki bir cache'e symlink yapar. Yerel bir extension koku de verilebilir
#: (mutlak yol).
COMPANION = os.environ.get(
    "SPECKIT_COMPANION",
    "https://github.com/alfredoperez/speckit-companion/releases/download/speckit-ext-v0.21.0/companion-0.21.0.zip")
#: Wiki, denetcinin ve spike'in yazdigi yer.
WIKI = Path(os.environ.get("CC_WORKSPACE", Path.home() / "workspace/cc-workspace"))

VERSION = "5.0.0"
#: install.sh kopyalarken bunu deponun commit'iyle degistirir; depodan
#: calistirilinca yerinde kalir ve git'ten okunur.
BUILD = "@BUILD@"

#: Makineye ozgu, commit'lenmeyen dosyalar; yalniz bunlar exclude'a girer.
LOCAL_ONLY = ["CLAUDE.local.md", ".claude/settings.local.json", ".direnv/"]


def build_info():
    if BUILD != "@" + "BUILD@":
        return BUILD
    git = lambda *a: subprocess.run(["git", "-C", str(ROOT), *a],
                                     capture_output=True, text=True).stdout.strip()
    commit = git("log", "-1", "--format=%h %cs")
    if not commit:
        return "kaynak bilinmiyor"
    return commit + (" +degisiklik" if git("status", "--porcelain") else "")


class Lang:
    """Bir dilin parcalarini alan baglam; `create.py`'ye de bu verilir."""

    def __init__(self, name, project, rules, keep=False):
        self.name, self.project, self.keep = name, project, keep
        self.dir, self.templates = TEMPLATES / name, TEMPLATES
        self._rules = rules

    def copy_files(self, sub, dest=".", replace=None):
        """`<dil>/<sub>/` altini dest'e kopyalar; `keep` ise var olan dosyayi atlar."""
        src = self.dir / sub
        for f in sorted(q for q in src.rglob("*") if q.is_file()):
            rel = Path(dest) / f.relative_to(src)
            if self.keep and rel.exists():
                print(f"atlandi: {rel} (var)")
                continue
            text = f.read_text()
            for k, v in (replace or {}).items():
                text = text.replace(k, v)
            rel.parent.mkdir(parents=True, exist_ok=True)
            rel.write_text(text)
            shutil.copymode(f, rel)
            print(f"created: {rel}")

    def defaults(self):
        """Varsayilan: olan parcalari al."""
        if (self.dir / "files").is_dir():
            self.copy_files("files")
        if (self.dir / "rules.md").is_file():
            self.rules(self.dir / "rules.md")
        if (self.dir / "testing.md").is_file():
            self.rules(self.dir / "testing.md", f"{self.name}-testing")

    def rules(self, path, name=None):
        """`.claude/rules/<name>.md` olarak kopyalanacak AI kurallari; name yoksa dilin adi."""
        self._rules[name or self.name] = path


def create_langs(langs, project, keep=False):
    """Her dilin parcalarini alir; kurallari dondurur."""
    rules = {}
    for l in langs:
        ctx = Lang(l, project, rules, keep)
        script = ctx.dir / "create.py"
        if not script.is_file():
            ctx.defaults()
            continue
        spec = importlib.util.spec_from_file_location(f"devenv_lang_{l}", script)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        mod.run(ctx)
    return rules


def copy_rules(rules):
    for l, src in rules.items():
        dst = Path(".claude/rules") / f"{l}.md"
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dst)
        print(f"created: {dst}")


def copy(template):
    kaynak = TEMPLATES / template
    if not kaynak.is_dir():
        sys.exit(f"sablon bulunamadi: {kaynak}\n"
                 f"install.sh'i calistir; sablonlar {SHARE / 'templates'} altina kopyalanir.")
    for f in sorted(p for p in kaynak.rglob("*") if p.is_file()):
        rel = f.relative_to(TEMPLATES / template)
        rel.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(f, rel)
        print(f"created: {rel}")


def edit(path, subs):
    p = Path(path)
    p.write_text(subs(p.read_text()))


def render(template, dest, subs):
    """`templates/speckit/project/<template>` altindakileri dest'e yazar, `{{AD}}`
    yer tutucularini doldurarak."""
    src = TEMPLATES / "speckit" / "project" / template
    for f in sorted(p for p in src.rglob("*") if p.is_file()):
        dst = Path(dest) / f.relative_to(src)
        text = f.read_text()
        for k, v in subs.items():
            text = text.replace("{{" + k + "}}", v)
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.write_text(text)
        shutil.copymode(f, dst)
        print(f"created: {dst}")


def nix_list(name, values):
    return f'  {name} = [ ' + "".join(f'"{v}" ' for v in values) + '];'


def run(*cmd):
    if subprocess.run(cmd).returncode != 0:
        sys.exit(f"basarisiz: {' '.join(cmd)}")


def speckit():
    """Spec Kit'i bu projeye kurar: CLI guncel, init ve extension'lar.

    Orchestration extension'i kurulmaz: hakem subagent'i ve after_* hook'lari
    karari yazan oturumun icinde verir, o karar denetcinindir.
    """
    if not shutil.which("specify"):
        sys.exit("specify yok: uv tool install specify-cli --from git+https://github.com/github/spec-kit.git")
    run("specify", "self", "upgrade")
    run("specify", "init", "--here", "--force", "--non-interactive",
        "--script", "sh", "--integration", "claude", "--extension", "agent-context",
        "--extension", "bug", "--extension", COMPANION, "--trust-extension-urls")
    # init kurulamayan extension'i tabloda hata olarak basip 0 ile cikiyor.
    if not Path(".specify/extensions/companion/extension.yml").is_file():
        sys.exit(f"companion kurulamadi: {COMPANION}; nedeni init'in tablosunda")

    optional_hooks()

    # Living specs ilk surumden sonra elle acilir: `enabled: true`, sonra
    # living-adopt. Dosya yoksa da kapali sayilir, ama capability kaydeden her
    # komut (register-capability) eksik dosyayi `enabled: true` ile yaratir;
    # var olan dosyanin bayragini korur.
    ls = Path("living-specs.yml")
    ls.write_text("enabled: false\ncapabilities: []\n")
    subprocess.run(["git", "add", "-N", str(ls)], check=True)
    print(f"created: {ls} (living specs kapali; git add it to keep it)")


def constitution(name):
    """Anayasayi sablondan yazar. Metin her projede aynidir; `/speckit-constitution`
    kosulmaz, cunku komut metni harmanlar ve neyin kalacagina model karar verir."""
    dst = Path(".specify/memory/constitution.md")
    text = (TEMPLATES / "speckit" / "constitution.md").read_text()
    dst.parent.mkdir(parents=True, exist_ok=True)
    dst.write_text(text.replace("{{NAME}}", name).replace("{{DATE}}", date.today().isoformat()))
    print(f"created: {dst}")


def optional_hooks():
    """agent-context'in optional hook'larini zorunlu yapar.

    Optional bir hook calistirilmaz, "calistirayim mi?" diye basilir; insansiz
    kosuda bu bir bekleme noktasidir. agent-context CLAUDE.md'deki SPECKIT
    START/END blogunu gunceller; hook'u kosmazsa blogu kimse doldurmaz.

    git extension kurulmaz: branch'i ve commit'i denetcinin baslattigi acik
    adimlarla impl atar. Hook'la acilan branch bulunulan HEAD'den cikiyordu ve
    prompt yoluyla atlanabiliyordu; commit hook'larinin mesaji da Conventional
    Commits'e uymuyordu.
    """
    kural = {"agent-context": ("    optional: true\n", "    optional: false\n")}
    p = Path(".specify/extensions.yml")
    if not p.is_file():
        print(f"atlandi: hook ayari ({p} yok)")
        return
    satirlar = p.read_text().splitlines(keepends=True)
    cikti, sayac, i = [], {e: 0 for e in kural}, 0
    while i < len(satirlar):
        ext = satirlar[i].rstrip().removeprefix("  - extension: ")
        if ext == satirlar[i].rstrip() or ext not in kural:
            cikti.append(satirlar[i])
            i += 1
            continue
        j = next((k for k in range(i + 1, len(satirlar)) if not satirlar[k].startswith("    ")), len(satirlar))
        girdi = satirlar[i:j]
        if "    optional: true\n" in girdi:
            eski, yeni = kural[ext]
            girdi = [yeni if s == eski else s for s in girdi]
            sayac[ext] += 1
        cikti += girdi
        i = j
    if not any(sayac.values()):
        print(f"UYARI:   {p} icinde ayarlanacak optional hook bulunamadi; bicim degismis olabilir")
        return
    p.write_text("".join(cikti))
    print(f"edited:  {p} ({sayac['agent-context']} agent-context hook'u zorunlu yapildi)")


ORNEKLER = """ornekler:
  devenv create ornek -l go -l rust --speckit   ./ornek/ornek-impl ve ./ornek/ornek-ctrl
  devenv create . --lang go --lang rust         bulundugun dizin proje dizini, adi proje adi
  devenv create ornek -l cpp --target aarch64   ./ornek urun reposu
  devenv create ornek -l node --node 22
  devenv add -l rust                            urun reposunda: projeye rust ekler"""

CREATE = """Proje kurar. --speckit'siz proje dizini urun reposudur:

  <ad>/            urun reposu: flake.nix, Makefile, CLAUDE.md; devshell burada derlenir

--speckit ile Spec Kit ve iki rollu duzen kurar:

  <ad>/            git degil; Claude burada calismaz. CLAUDE.md ortak protokolu tasir
    <ad>-impl/     urun reposu: flake.nix, Makefile, CLAUDE.md, Spec Kit, rol metni
                   .claude/rules/'da. devshell burada derlenir. Makineye ozgu olanlar
                   git disinda: CLAUDE.local.md, .claude/settings.local.json
    <ad>-ctrl/     denetci: CLAUDE.md, rol metni .claude/rules/'da, .claude/settings.json,
                   skill'ler

Proje dizini doluysa once sorar (y/N). y ise sablon dosyalarini var olanlarin
ustune yazar; baska dosyaya dokunmaz, hicbir sey silmez. Var olan projeye dil
eklemek create'in isi degil: devenv add."""

ADD = """Bulundugun urun reposuna dil ekler:

  flake.nix        langs'e eklenir
  dilin dosyalari  var olan dosya atlanir
  .claude/rules/<dil>.md, varsa <dil>-testing.md

Makefile'a, CLAUDE.md'ye, Spec Kit'e ve rol dosyalarina dokunmaz; kaynak
dosyasi yaratmaz. O dilde bir bileşen acilinca kendi Makefile'iyla gelir. Sonra
devshell yeniden derlenir."""


def parser():
    ap = argparse.ArgumentParser(
        prog="devenv", formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Proje: <ad>/ urun reposu; --speckit ile <ad>/<ad>-impl (urun, yazan) "
                    "ve <ad>/<ad>-ctrl (denetci).",
        epilog=ORNEKLER)
    ap.add_argument("--version", action="version", version=f"devenv {VERSION} ({build_info()})")
    sub = ap.add_subparsers(dest="command", required=True, metavar="komut")
    c = sub.add_parser("create", help="yeni proje kur",
                       formatter_class=argparse.RawDescriptionHelpFormatter,
                       description=CREATE, epilog=ORNEKLER)
    c.add_argument("name", metavar="ad",
                   help="proje adi, ya da `.`: bulundugun dizin proje dizinidir ve adi proje adidir. "
                        "Urunun icindeki adlar bundan gelir, dizin adindan degil")
    c.add_argument("-l", "--lang", dest="langs", action="append", required=True, metavar="dil",
                   help=" | ".join(LANGS) + " (tekrarlanabilir)")
    c.add_argument("--target", action="append", default=[],
                   help="capraz derleme hedefi: aarch64 | armv7 (tekrarlanabilir)")
    c.add_argument("--node", help=".nvmrc icin node major surumu, ornek 22")
    c.add_argument("--speckit", action="store_true",
                   help="Spec Kit ve iki rollu duzen (<ad>-impl, <ad>-ctrl) kur: self upgrade, init + agent-context "
                        "(CLAUDE.md blogu), bug, companion, living specs kapali; anayasa sablondan yazilir")
    d = sub.add_parser("add", help="urun reposuna dil ekle",
                       formatter_class=argparse.RawDescriptionHelpFormatter, description=ADD)
    d.add_argument("-l", "--lang", dest="langs", action="append", required=True, metavar="dil",
                   help=" | ".join(LANGS) + " (tekrarlanabilir)")
    return ap


def create_project(name, speckit):
    """Proje dizinini kurar ve urun reposuna gecer; reponun kurulumu main'e kalir.

    --speckit'siz urun reposu proje dizininin kendisidir. --speckit ile iki
    rollu duzen kurulur ve urun reposu impl'dir. O zaman ust dizin git reposu
    olamaz: Claude'un hafizasi repoya gore tutulur, ust dizin repo olursa impl
    ile ctrl ayni hafizayi paylasir.
    """
    if name == ".":
        root = Path.cwd()
        name = root.name
    elif not name or "/" in name or name == "..":
        sys.exit(f"gecersiz proje adi: {name!r}")
    else:
        root = Path.cwd() / name
    if speckit and (root / ".git").exists():
        sys.exit(f"{root} bir git reposu; ust dizin repo olamaz.")
    if root.is_dir() and any(root.iterdir()):
        try:
            answer = input(f"{root}: burada bir seyler var, ezeyim mi? [y/N] ")
        except EOFError:
            answer = ""
        if answer.strip().lower() != "y":
            sys.exit("vazgecildi; hicbir seye dokunulmadi")
    subs = {"NAME": name, "ROOT": str(root), "WIKI": str(WIKI)}
    if not speckit:
        root.mkdir(exist_ok=True)
        os.chdir(root)
        return subs
    impl, ctrl = root / f"{name}-impl", root / f"{name}-ctrl"
    impl.mkdir(parents=True, exist_ok=True)
    ctrl.mkdir(exist_ok=True)
    render("parent", root, subs)
    render("ctrl", ctrl, subs)
    os.chdir(impl)
    return subs


def main():
    a = parser().parse_args()

    langs = [ALIAS.get(l.lower(), l.lower()) for l in a.langs]
    unknown = [l for l in langs if l not in LANGS]
    if unknown:
        sys.exit(f"unknown language: {' '.join(unknown)} (pick from {' '.join(LANGS)})")
    if a.command == "add":
        add(langs)
        return
    targets = [ALIAS.get(t.lower(), t.lower()) for t in a.target if t.lower() != "none"]

    subs = create_project(a.name, a.speckit)
    setup(a, langs, targets, subs)
    build()
    root, name = subs["ROOT"], subs["NAME"]
    if not a.speckit:
        print(f"oturum:    cd {root} && claude -n {name}")
        return
    print(f"oturumlar: cd {root}/{name}-impl && claude -n {name}-impl")
    print(f"           cd {root}/{name}-ctrl && claude -n {name}-ctrl")


def setup(a, langs, targets, subs):
    if not Path(".git").is_dir():
        subprocess.run(["git", "init", "-q"], check=True)
        print("created: .git")

    copy("base")
    edit("flake.nix", lambda t: t
         .replace('dev-templates.url = "github:bulent-kopuklu/devenv";',
                  f'dev-templates.url = "{REF}";')
         .replace('  langs = [ ];', nix_list("langs", langs))
         .replace('  targets = [ ];', nix_list("targets", targets) if targets else '  targets = [ ];'))
    subprocess.run(["git", "add", "-N", "flake.nix"], check=True)
    print("git:     flake.nix intent-to-added so nix can read it; git add it to keep it")

    rules = create_langs(langs, subs["NAME"])

    copy("make")
    edit("Makefile", lambda t: t.replace("{{NAME}}", subs["NAME"]))
    subprocess.run(["git", "add", "-N", "Makefile"], check=True)
    print("git:     Makefile intent-to-added; it belongs to the project, git add it to keep it")

    Path(".envrc").write_text("use flake\n")
    print("created: .envrc")

    if a.node:
        Path(".nvmrc").write_text(f"{a.node}\n")
        subprocess.run(["git", "add", "-N", ".nvmrc"], check=True)
        print(f"git:     .nvmrc ({a.node}) intent-to-added; the flake reads only what git knows")

    copy_rules(rules)
    if a.speckit:
        render("impl", Path("."), subs)
    else:
        copy("claude")
        edit("CLAUDE.md", lambda t: t.replace("# PROJECT_NAME", f"# {subs['NAME']}"))

    already = Path(".git/info/exclude").read_text().splitlines()
    excluded = [f for f in LOCAL_ONLY if f not in already]
    if excluded:
        with open(".git/info/exclude", "a") as f:
            f.write("# dev-templates (local only)\n" + "\n".join(excluded) + "\n")
        for e in excluded:
            print(f"excluded: {e}")

    if a.speckit:
        speckit()
        constitution(subs["NAME"])


def add(langs):
    """Urun reposuna dil ekler; `devenv add`in yardim metnindeki gibi."""
    flake = Path("flake.nix")
    if not flake.is_file():
        sys.exit("flake.nix yok; devenv add urun reposunun kokunde calisir")
    text = flake.read_text()
    satir = re.compile(r"^( *)langs = \[([^\]]*)\];", re.M)
    m = satir.search(text)
    if not m:
        sys.exit("flake.nix'te `langs = [ ... ];` satiri bulunamadi")
    have = re.findall(r'"([^"]+)"', m.group(2))
    new = [l for l in dict.fromkeys(langs) if l not in have]
    if not new:
        print(f"zaten var: {' '.join(langs)}")
        return
    flake.write_text(satir.sub(lambda _: m.group(1) + nix_list("langs", have + new).lstrip(), text, count=1))
    print(f"edited:  flake.nix (langs: {' '.join(have + new)})")

    copy_rules(create_langs(new, None, keep=True))
    build()


def build():
    if shutil.which("direnv"):
        subprocess.run(["direnv", "allow", "."], check=True)
        print("direnv:  allowed")
    print("building the devshell (runtimes, LSPs, formatters) ...")
    if subprocess.run(["nix", "develop", "--command", "true"]).returncode != 0:
        sys.exit("devshell failed to build; the nix error is above")
    print("ready. open the editor from this shell: code .")


if __name__ == "__main__":
    main()
