{
  "permissions": {
    "deny": [
      "Edit(/{{ROOT}}/{{NAME}}-ctrl/**)",
      "Read(/{{ROOT}}/{{NAME}}-ctrl/**)",
      "Skill(spike)",
      "Skill(spike *)"
    ],
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(make gate)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "echo 'Özeti Türkçe yaz; teknik terimler çevrilmez.'" }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "61"
  }
}
