{
  "permissions": {
    "additionalDirectories": [
      "{{ROOT}}/{{NAME}}-impl",
      "{{WIKI}}"
    ],
    "deny": [
      "Edit(/{{ROOT}}/{{NAME}}-impl/**)"
    ],
    "allow": [
      "Read(/{{CONFIGABS}}/CLAUDE.md)",
      "Bash(scripts/feature-branch.sh *)",
      "Bash(git -C {{ROOT}}/{{NAME}}-impl add *)",
      "Bash(git -C {{ROOT}}/{{NAME}}-impl commit *)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "echo 'Özeti Türkçe yaz; teknik terimler çevrilmez.'" }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "61"
  }
}
